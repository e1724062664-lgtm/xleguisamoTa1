<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="xleguisamoTa1.Views.Principal"
             Title="Inscripción"
             BackgroundColor="#F5F5F5">
  

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            
            <Label Text="UNIVERSIDAD ISRAEL"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#003366" 
                   HorizontalOptions="Center" />

            <Label Text="Formulario de Registro"
                   FontSize="16"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

           
            <Label Text="Datos personales" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   TextColor="#003366"
                   Margin="0,10,0,0"/>

            <Entry x:Name="txtIdentificacion"
                   Placeholder="Identificación"
                   Keyboard="Text"/>

            <Entry x:Name="txtApellido"
                   Placeholder="Apellido"
                   Keyboard="Text"/>

            <Entry x:Name="txtNombreCompletos"
                   Placeholder="Nombre completos"
                   Keyboard="Text"/>

           
            <Entry x:Name="txtTelefono"
                   Placeholder="Teléfono personal"
                   Keyboard="Telephone"/>

            <Entry x:Name="txtCorreo"
                   Placeholder="Correo personal"
                   Keyboard="Email"/>

            <Entry x:Name="txtConfirmarCorreo"
                   Placeholder="Confirmar correo"
                   Keyboard="Email"/>

         
            <Label Text="Información universitaria" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   TextColor="#003366"
                   Margin="0,15,0,0"/>

            <Entry x:Name="txtCarrera"
                   Placeholder="Carrera"
                   Keyboard="Text"/>

            <Entry x:Name="txtModalidad"
                   Placeholder="Modalidad"
                   Keyboard="Text"/>

            <Entry x:Name="txtCampus"
                   Placeholder="Campus"
                   Keyboard="Text"/>

            
            <Button x:Name="btnGuardar"
                    Text="GUARDAR REGISTRO"
                    Clicked="btnGuardar_Clicked"
                    BackgroundColor="#003366"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Margin="0,20,0,10"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>